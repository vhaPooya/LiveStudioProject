# Copy to .env and fill in. NEVER commit .env.
SITE_DOMAIN=studio.example.com
LIVEKIT_DOMAIN=live.example.com

# Same random value for Web and Api (>= 24 chars):  openssl rand -hex 32
Platform__InternalApiKey=CHANGE_ME

# Built-in admin (>= 10 chars)
Admin__Username=admin
Admin__Password=CHANGE_ME

# LiveKit (must match livekit.yaml of the existing stack)
LiveKit__ApiKey=CHANGE_ME
LiveKit__ApiSecret=CHANGE_ME
