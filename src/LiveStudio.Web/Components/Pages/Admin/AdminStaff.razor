@page "/admin/staff"
@layout AdminLayout
@attribute [Authorize(Policy = "perm:staff")]
@inject CurrentUser Me
@inject IStaffService Staff
@inject IJSRuntime JS

<PageTitle>کاربران مدیریت | مدیریت LiveStudio</PageTitle>
<header class="topbar"><div><div class="eyebrow">ADMIN / STAFF</div><h1>کاربران مدیریت و دسترسی‌ها</h1></div><button class="btn btn-primary" @onclick="NewUser"><i class="bi bi-person-plus ms-1"></i>کاربر جدید</button></header>
<Notice Error="@_error" Success="@_success" />

@if (_edit)
{
    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">STAFF</div><h3>@(_id is null ? "تعریف کاربر مدیریتی" : "ویرایش کاربر مدیریتی")</h3></div></div>
        <div class="form-grid">
            <div><label class="form-label">نام کاربری</label><input class="form-control ltr-input" maxlength="32" @bind="_username" disabled="@(_id is not null)" /></div>
            <div><label class="form-label">نام نمایشی</label><input class="form-control" maxlength="120" @bind="_displayName" /></div>
            <div><label class="form-label">رمز عبور @(_id is null ? "" : "(برای حفظ رمز فعلی خالی بگذارید)")</label><input class="form-control ltr-input" type="password" autocomplete="new-password" @bind="_password" /></div>
            <div class="check-row"><label><input type="checkbox" @bind="_active" /> حساب فعال باشد</label></div>
        </div>
        <h6 class="mt-3">دسترسی‌ها</h6>
        <div class="perm-grid">@foreach (var p in Permissions.All)
        {
            <label class="perm @(_perms.Contains(p.Key) ? "on" : "")"><input type="checkbox" checked="@_perms.Contains(p.Key)" @onchange="e => Toggle(p.Key, (bool)(e.Value ?? false))" /><span><strong>@p.Title</strong><small>@p.Description</small></span></label>
        }</div>
        <div class="btn-row mt-3"><button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy"><i class="bi bi-check2 ms-1"></i>ذخیره</button><button class="btn btn-outline-secondary" @onclick="() => _edit = false">انصراف</button></div>
    </section>
}

<section class="panel mt-3">
    <div class="toolbar"><SearchBox Value="@_query" ValueChanged="OnSearch" Placeholder="جستجو در نام کاربری یا نام نمایشی..." /></div>
    @if (_result.Items.Count == 0) { <div class="empty-state"><div class="empty-icon"><i class="bi bi-person-gear"></i></div><strong>کاربر مدیریتی تعریف نشده است</strong><p>مدیر اصلی با نام کاربری ثابت همیشه به همه بخش‌ها دسترسی دارد.</p></div> }
    else
    {
        <div class="table-wrap"><table class="data-table"><thead><tr><th>کاربر</th><th>نام کاربری</th><th>دسترسی‌ها</th><th>آخرین ورود</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>@foreach (var s in _result.Items)
            {
                <tr><td><div class="cell-user"><span class="avatar sm admin-avatar">@Fa.Initials(s.DisplayName)</span><strong>@s.DisplayName</strong></div></td><td class="ltr-text">@s.Username</td>
                    <td>@foreach (var key in Permissions.Parse(s.PermissionsCsv)) { <span class="b b-blue me-1">@Title(key)</span> }</td>
                    <td>@Fa.Date(s.LastLoginAt, true)</td><td><span class="b @(s.IsActive ? "b-green" : "b-gray")">@(s.IsActive ? "فعال" : "غیرفعال")</span></td>
                    <td class="actions"><button class="btn btn-outline-secondary btn-sm" @onclick="() => Edit(s)"><i class="bi bi-pencil"></i></button><button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(s)"><i class="bi bi-trash"></i></button></td></tr>
            }</tbody></table></div>
        <Pager Page="_result.Page" TotalPages="_result.TotalPages" Total="_result.Total" PageChanged="GoPage" />
    }
</section>

@code {
    private PagedResult<StaffUser> _result = PagedResult<StaffUser>.Empty();
    private string? _query, _error, _success;
    private int _page = 1;
    private bool _edit, _busy, _active = true;
    private Guid? _id;
    private string _username = string.Empty, _displayName = string.Empty, _password = string.Empty;
    private HashSet<string> _perms = new(StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() => _result = await Staff.SearchAsync(_query, _page, 10);
    private async Task OnSearch(string text) { _query = text; _page = 1; await LoadAsync(); }
    private async Task GoPage(int page) { _page = page; await LoadAsync(); }
    private static string Title(string key) => Permissions.All.FirstOrDefault(p => p.Key == key).Title ?? key;

    private void NewUser() { _id = null; _username = _displayName = _password = string.Empty; _active = true; _perms = new(StringComparer.OrdinalIgnoreCase) { Permissions.Dashboard, Permissions.Tickets }; _edit = true; _error = _success = null; }
    private void Edit(StaffUser s) { _id = s.Id; _username = s.Username; _displayName = s.DisplayName; _password = string.Empty; _active = s.IsActive; _perms = new(Permissions.Parse(s.PermissionsCsv), StringComparer.OrdinalIgnoreCase); _edit = true; _error = _success = null; }
    private void Toggle(string key, bool on) { if (on) _perms.Add(key); else _perms.Remove(key); }

    private async Task SaveAsync()
    {
        _busy = true; _error = _success = null;
        var result = await Staff.SaveAsync(_id, _username, _displayName, _password, _perms, _active, await Me.ActorAsync());
        if (result.Success) { _success = "کاربر مدیریتی ذخیره شد؛ تغییر دسترسی‌ها حداکثر تا ۴۵ ثانیه بعد اعمال می‌شود."; _edit = false; await LoadAsync(); } else _error = result.Error;
        _busy = false;
    }

    private async Task DeleteAsync(StaffUser s)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"کاربر «{s.Username}» حذف شود؟")) return;
        var result = await Staff.DeleteAsync(s.Id, await Me.ActorAsync());
        if (result.Success) { _success = "حذف شد."; await LoadAsync(); } else _error = result.Error;
    }
}
