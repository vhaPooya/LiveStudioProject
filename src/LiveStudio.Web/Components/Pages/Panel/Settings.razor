@page "/panel/settings"
@attribute [Authorize(Policy = "Customer")]
@implements IDisposable
@inject CurrentUser User
@inject IUserService Users
@inject ISubscriptionService Subscriptions
@inject IGoogleOAuthTenantService OAuth
@inject IDriveStorageService Drive
@inject NavigationManager Navigation

<PageTitle>تنظیمات | LiveStudio</PageTitle>

<header class="topbar"><div><div class="eyebrow">ACCOUNT / SETTINGS</div><h1>تنظیمات حساب کاربری</h1></div></header>

<div class="tabs">
    <button class="@Tab("profile")" @onclick='() => SetTab("profile")'><i class="bi bi-person"></i>مشخصات</button>
    <button class="@Tab("subscription")" @onclick='() => SetTab("subscription")'><i class="bi bi-gem"></i>اشتراک</button>
    <button class="@Tab("oauth")" @onclick='() => SetTab("oauth")'><i class="bi bi-google"></i>Google OAuth Settings
        @if (_oauth is not null) { <span class="b @Fa.OAuthStateClass(_oauth.State)">@Fa.OAuthState(_oauth.State)</span> }</button>
    <button class="@Tab("drive")" @onclick='() => SetTab("drive")'><i class="bi bi-hdd-network"></i>ذخیره‌سازی ویدئو
        @if (_drive is { Enabled: true }) { <span class="b ok">Drive</span> }</button>
</div>

<Notice Error="@_error" Success="@_success" />

@if (_loading) { <div class="loading-panel">در حال بارگذاری...</div> }
else if (_tab == "profile" && _user is not null)
{
    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">PROFILE</div><h3>مشخصات کاربری</h3></div></div>
        <div class="form-grid">
            <div><label class="form-label">نام و نام خانوادگی</label><input class="form-control" maxlength="120" @bind="_fullName" /></div>
            <div><label class="form-label">ایمیل (اختیاری)</label><input class="form-control ltr-input" maxlength="200" type="email" @bind="_email" /></div>
            <div><label class="form-label">نام کانال یوتیوب (اختیاری)</label><input class="form-control" maxlength="200" @bind="_channelName" /></div>
            <div><label class="form-label">کد ملی</label><input class="form-control ltr-input" value="@_user.NationalCode" disabled /><div class="form-text">برای تغییر کد ملی یا موبایل از بخش تیکت‌ها درخواست دهید.</div></div>
            <div><label class="form-label">شماره موبایل</label><input class="form-control ltr-input" value="@_user.Mobile" disabled /></div>
            <div><label class="form-label">تاریخ عضویت</label><input class="form-control" value="@Fa.Date(_user.CreatedAt)" disabled /></div>
        </div>
        <button class="btn btn-primary mt-3" @onclick="SaveProfileAsync" disabled="@_busy"><i class="bi bi-check2 ms-1"></i>ذخیره تغییرات</button>
    </section>
}
else if (_tab == "subscription")
{
    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">SUBSCRIPTION</div><h3>وضعیت اشتراک</h3></div><span class="b @(_sub.IsActive ? "b-green" : "b-red")">@(_sub.IsActive ? "فعال" : "غیرفعال")</span></div>
        <div class="sub-hero">
            <div class="ring" style="--p:@(_sub.IsActive ? _sub.Percent : 0)"><div><strong>@(_sub.IsActive ? _sub.DaysLeft : 0)</strong><small>روز باقی‌مانده</small></div></div>
            <div class="sub-info">
                <div><small>طرح فعلی</small><strong>@_sub.PlanName</strong></div>
                <div><small>شروع</small><strong>@Fa.Date(_sub.StartsAt)</strong></div>
                <div><small>پایان اشتراک</small><strong>@Fa.Date(_sub.EndsAt)</strong></div>
                <a class="btn btn-primary" href="/panel/subscription"><i class="bi bi-arrow-repeat ms-1"></i>@(_sub.IsActive ? "تمدید اشتراک" : "خرید اشتراک")</a>
            </div>
        </div>
        @if (_history.Count > 0)
        {
            <h6 class="mt-4">تاریخچه اشتراک‌ها</h6>
            <div class="table-wrap"><table class="data-table">
                <thead><tr><th>طرح</th><th>از</th><th>تا</th><th>منبع</th><th>وضعیت</th></tr></thead>
                <tbody>@foreach (var h in _history)
                {
                    <tr><td>@h.PlanName</td><td>@Fa.Date(h.StartsAt)</td><td>@Fa.Date(h.EndsAt)</td>
                        <td>@(h.Source switch { SubscriptionSource.Trial => "هدیه ثبت‌نام", SubscriptionSource.Admin => "مدیر", _ => "پرداخت" })</td>
                        <td><span class="b @(h.Status == SubscriptionStatus.Cancelled ? "b-gray" : h.EndsAt > DateTime.UtcNow ? "b-green" : "b-amber")">@(h.Status == SubscriptionStatus.Cancelled ? "لغو شده" : h.EndsAt > DateTime.UtcNow ? "فعال" : "پایان‌یافته")</span></td></tr>
                }</tbody></table></div>
        }
    </section>
}
else if (_tab == "drive")
{
    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">MEDIA BOX STORAGE</div><h3>ذخیره‌سازی ویدئوها در Google Drive</h3></div>
            @if (_drive is { Enabled: true }) { <span class="status-pill">CONNECTED</span> }</div>
        <p class="muted">تصاویر و فایل‌های سبک روی سرور ذخیره می‌شوند؛ ویدئوهای Media Box در فضای Google Drive خودِ شما ذخیره می‌شوند. برنامه فقط به فایل‌هایی که خودش می‌سازد (پوشه‌ی «LiveStudio Media») دسترسی دارد.</p>
        @if (_drive is null || !_drive.OAuthConnected)
        {
            <p>ابتدا در تب «Google OAuth Settings» حساب گوگل خود را متصل کنید.</p>
        }
        else if (_drive.Enabled)
        {
            <p>حساب: <strong class="ltr-text">@_drive.Email</strong> · پوشه: <strong>@_drive.FolderName</strong></p>
            <button class="btn btn-ghost" disabled="@_busy" @onclick="DisableDriveAsync">غیرفعال‌سازی</button>
            <p class="muted mt-2">فایل‌های قبلی در Drive می‌مانند. برای لغو کامل دسترسی، آن را از بخش Security حساب گوگل حذف کنید.</p>
        }
        else
        {
            <p class="muted">لازم است «Google Drive API» در پروژه‌ی Google Cloud شما فعال باشد و دسترسی Drive را در صفحه‌ی گوگل تأیید کنید.</p>
            <a class="btn btn-primary" href="/oauth/google/start?drive=1" target="_self"><i class="bi bi-google"></i> اتصال Google Drive</a>
        }
    </section>
}
else if (_tab == "oauth" && _oauth is not null)
{
    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">GOOGLE OAUTH SETTINGS</div><h3>اتصال کانال یوتیوب با Client اختصاصی شما</h3></div><span class="b @Fa.OAuthStateClass(_oauth.State)">@Fa.OAuthState(_oauth.State)</span></div>
        <p class="form-hint">شما مالک پروژه Google Cloud خودتان هستید. نرم‌افزار Client ID و Secret را نمی‌سازد و تغییر نمی‌دهد؛ فقط اطلاعاتی را که شما ثبت می‌کنید اعتبارسنجی، رمزنگاری و فقط برای حساب شما نگهداری می‌کند.</p>

        <ol class="oauth-steps">
            @foreach (var (s, i) in OAuthSteps().Select((s, i) => (s, i)))
            {
                <li class="@s.Css"><span>@(s.Done ? "✓" : (i + 1).ToString())</span><div><strong>@s.Title</strong><small>@s.Text</small></div></li>
            }
        </ol>

        @if (!string.IsNullOrWhiteSpace(_oauth.LastError) && _oauth.State == OAuthConnectionState.Error)
        {
            <div class="notice notice-error"><i class="bi bi-exclamation-triangle-fill ms-2"></i>@_oauth.LastError</div>
        }
    </section>

    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">TUTORIAL</div><h3>ویدئوی آموزش دریافت کلیدها از کنسول گوگل</h3></div></div>
        @if (!string.IsNullOrWhiteSpace(_oauth.TutorialVideoUrl))
        {
            @if (IsDirectVideo(_oauth.TutorialVideoUrl)) { <video class="tutorial-video" controls preload="metadata" src="@_oauth.TutorialVideoUrl"></video> }
            else { <div class="tutorial-frame"><iframe src="@EmbedUrl(_oauth.TutorialVideoUrl)" title="آموزش Google OAuth" allowfullscreen loading="lazy"></iframe></div> }
        }
        else { <div class="empty-state"><div class="empty-icon"><i class="bi bi-play-circle"></i></div><strong>ویدئوی راهنما هنوز بارگذاری نشده است</strong><p>مدیر سامانه به‌زودی ویدئو را قرار می‌دهد. در این فاصله می‌توانید از تیکت‌ها راهنمایی بخواهید.</p></div> }
        <div class="redirect-box">
            <label class="form-label">Authorized redirect URI (در Google Cloud دقیقاً همین آدرس را ثبت کنید)</label>
            <div class="copy-row"><code class="ltr-text">@_oauth.RedirectUri</code><button class="btn btn-outline-secondary btn-sm" @onclick="() => CopyAsync(_oauth.RedirectUri)"><i class="bi bi-clipboard ms-1"></i>کپی</button></div>
            <div class="form-text">این آدرس برای همه مشتریان یکسان است و متعلق به نرم‌افزار است. فعال‌سازی «YouTube Data API v3» و تنظیم OAuth consent screen در پروژه شما الزامی است.</div>
        </div>
    </section>

    <section class="panel mt-3">
        <div class="panel-heading"><div><div class="eyebrow">CREDENTIALS</div><h3>اطلاعات Client</h3></div></div>
        <div class="form-grid">
            <div class="span-2"><label class="form-label">Client ID</label><input class="form-control ltr-input" @bind="_clientId" placeholder="123456789-xxxx.apps.googleusercontent.com" autocomplete="off" /></div>
            <div><label class="form-label">Client Secret @if (_oauth.HasSecret) { <span class="b b-green">ذخیره شده</span> }</label>
                <input class="form-control ltr-input" type="password" @bind="_clientSecret" autocomplete="new-password" placeholder="@(_oauth.HasSecret ? "برای حفظ مقدار فعلی خالی بگذارید" : "GOCSPX-...")" />
                <div class="form-text">Secret پس از ذخیره هرگز دوباره نمایش داده نمی‌شود.</div></div>
            <div><label class="form-label">Project ID</label><input class="form-control ltr-input" @bind="_projectId" placeholder="my-live-project" autocomplete="off" /></div>
        </div>
        <div class="btn-row mt-3">
            <button class="btn btn-primary" @onclick="SaveOAuthAsync" disabled="@_busy"><i class="bi bi-shield-check ms-1"></i>اعتبارسنجی و ذخیره</button>
            @if (_oauth.HasSettings)
            {
                <button class="btn btn-success" @onclick="StartAuthorization" disabled="@_busy"><i class="bi bi-google ms-1"></i>@(_oauth.State == OAuthConnectionState.Connected ? "اتصال مجدد به گوگل" : "ادامه و تأیید در گوگل")</button>
                @if (_oauth.State == OAuthConnectionState.Connected)
                {
                    <button class="btn btn-outline-secondary" @onclick="TestAsync" disabled="@_busy"><i class="bi bi-activity ms-1"></i>تست اتصال</button>
                    <button class="btn btn-outline-secondary" @onclick="() => DisconnectAsync(false)" disabled="@_busy"><i class="bi bi-plug ms-1"></i>قطع اتصال</button>
                }
                <button class="btn btn-outline-danger" @onclick="() => DisconnectAsync(true)" disabled="@_busy"><i class="bi bi-trash ms-1"></i>حذف اطلاعات</button>
            }
        </div>
    </section>

    @if (_oauth.State == OAuthConnectionState.Connected)
    {
        <section class="panel mt-3">
            <div class="panel-heading"><div><div class="eyebrow">CONNECTED CHANNEL</div><h3>کانال متصل‌شده</h3></div><span class="status-pill">CONNECTED</span></div>
            <div class="channel-details">
                @if (!string.IsNullOrWhiteSpace(_oauth.ChannelThumbnailUrl)) { <img class="channel-avatar" src="@_oauth.ChannelThumbnailUrl" alt="کانال" referrerpolicy="no-referrer" /> }
                <div class="channel-title"><strong>@_oauth.ChannelTitle</strong><small class="ltr-text">@_oauth.GoogleEmail</small></div>
                <div class="channel-meta"><small>زمان اتصال</small><strong>@Fa.Date(_oauth.ConnectedAt, true)</strong></div>
                <div class="channel-meta"><small>آخرین تست</small><strong>@Fa.Date(_oauth.LastTestAt, true)</strong></div>
            </div>
        </section>
    }
}

@code {
    private AppUser? _user;
    private SubscriptionInfo _sub = SubscriptionInfo.None;
    private IReadOnlyList<UserSubscription> _history = [];
    private GoogleOAuthSettingsView? _oauth;
    private DriveStatus? _drive;
    private string _tab = "profile";
    private bool _loading = true, _busy;
    private string? _error, _success;
    private string _fullName = string.Empty, _email = string.Empty, _channelName = string.Empty;
    private string _clientId = string.Empty, _clientSecret = string.Empty, _projectId = string.Empty;
    private Guid _userId;

    private string Tab(string key) => _tab == key ? "active" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _userId = await User.UserIdAsync() ?? Guid.Empty;
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("tab", out var tab) && tab.ToString() is "profile" or "subscription" or "oauth" or "drive") _tab = tab.ToString();
        if (query.TryGetValue("oauth", out var result))
        {
            var message = query.TryGetValue("message", out var m) ? m.ToString() : null;
            if (result.ToString() == "ok") _success = message; else _error = message ?? "اتصال ناموفق بود.";
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _user = await Users.GetAsync(_userId);
        if (_user is not null) { _fullName = _user.FullName; _email = _user.Email ?? string.Empty; _channelName = _user.ChannelName ?? string.Empty; }
        _sub = await Subscriptions.GetCurrentAsync(_userId);
        _history = await Subscriptions.HistoryAsync(_userId);
        _oauth = await OAuth.GetAsync(_userId);
        _drive = await Drive.GetStatusAsync(_userId);
        _clientId = _oauth.ClientId; _projectId = _oauth.ProjectId; _clientSecret = string.Empty;
        _loading = false;
    }

    private async Task DisableDriveAsync()
    {
        _busy = true;
        await Drive.DisableAsync(_userId);
        _drive = await Drive.GetStatusAsync(_userId);
        _success = "استفاده از Google Drive غیرفعال شد."; _busy = false;
    }

    private void SetTab(string tab) { _tab = tab; _error = _success = null; }

    private async Task SaveProfileAsync()
    {
        _busy = true; _error = _success = null;
        var result = await Users.UpdateProfileAsync(_userId, _fullName, _email, _channelName, await User.ActorAsync());
        if (result.Success) _success = "مشخصات با موفقیت ذخیره شد."; else _error = result.Error;
        _busy = false;
    }

    private async Task SaveOAuthAsync()
    {
        _busy = true; _error = _success = null;
        var result = await OAuth.SaveAsync(_userId, new GoogleOAuthSaveRequest(_clientId, _clientSecret, _projectId), await User.ActorAsync());
        if (result.Success) { _success = "اطلاعات اعتبارسنجی و به‌صورت رمزنگاری‌شده ذخیره شد. برای ادامه، دسترسی را در گوگل تأیید کنید."; await LoadAsync(); }
        else _error = result.Error;
        _busy = false;
    }

    private void StartAuthorization() => Navigation.NavigateTo("/oauth/google/start", forceLoad: true);

    private async Task TestAsync()
    {
        _busy = true; _error = _success = null;
        var result = await OAuth.TestConnectionAsync(_userId, await User.ActorAsync());
        if (result.Success) _success = "اتصال برقرار است و کانال یوتیوب در دسترس است."; else _error = result.Error;
        await LoadAsync();
        _busy = false;
    }

    private async Task DisconnectAsync(bool remove)
    {
        _busy = true; _error = _success = null;
        await OAuth.DisconnectAsync(_userId, remove, await User.ActorAsync());
        _success = remove ? "اطلاعات OAuth حذف شد." : "اتصال کانال قطع شد.";
        await LoadAsync();
        _busy = false;
    }

    private record StepView(string Title, string Text, bool Done, string Css);

    private IEnumerable<StepView> OAuthSteps()
    {
        var s = _oauth!.State;
        var saved = _oauth.HasSettings && _oauth.HasSecret;
        var connected = s == OAuthConnectionState.Connected;
        string Css(bool done, bool current) => done ? "done" : current ? "current" : string.Empty;
        yield return new("اعتبارسنجی اطلاعات", "فرمت Client ID، وجود Secret، Project ID و HTTPS بودن Redirect URI", saved, Css(saved, !saved));
        yield return new("ذخیره امن تنظیمات", "رمزنگاری Secret و اختصاص آن به حساب شما", saved, Css(saved, false));
        yield return new("آماده‌سازی OAuth", "ساخت درخواست با Client ID اختصاصی شما و PKCE", connected || s == OAuthConnectionState.AwaitingConsent, Css(connected || s == OAuthConnectionState.AwaitingConsent, saved && !connected));
        yield return new("تأیید در گوگل", "انتخاب حساب و تأیید مجوزهای یوتیوب در Consent Screen", connected, Css(connected, s == OAuthConnectionState.AwaitingConsent));
        yield return new("دریافت Callback و بررسی State", "بازگشت به نرم‌افزار و اعتبارسنجی state یک‌بارمصرف", connected, Css(connected, false));
        yield return new("تست اتصال", "تبادل Code با Token و بررسی هویت و دسترسی به کانال", connected, Css(connected, false));
        yield return new("فعال‌سازی", "وضعیت اتصال شما به Connected تغییر می‌کند", connected, Css(connected, false));
    }

    private static bool IsDirectVideo(string url) => url.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) || url.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) || url.StartsWith("/");

    private static string EmbedUrl(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps) return "about:blank";
        var host = uri.Host.ToLowerInvariant();
        if (host.EndsWith("youtube.com") && uri.AbsolutePath == "/watch")
        {
            var v = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("v", out var id) ? id.ToString() : null;
            if (!string.IsNullOrEmpty(v)) return $"https://www.youtube-nocookie.com/embed/{Uri.EscapeDataString(v)}";
        }
        if (host == "youtu.be") return $"https://www.youtube-nocookie.com/embed/{Uri.EscapeDataString(uri.AbsolutePath.Trim('/'))}";
        if (host.EndsWith("aparat.com") && uri.AbsolutePath.Contains("/v/")) return $"https://www.aparat.com/video/video/embed/videohash/{uri.AbsolutePath.Split('/').Last()}/vt/frame";
        return url;
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    private async Task CopyAsync(string text) { try { await JS.InvokeVoidAsync("lsSite.copy", text); _success = "کپی شد."; } catch (JSException) { } }
    public void Dispose() { }
}
