@page "/panel/stats"
@attribute [Authorize(Policy = "Customer")]
@inject CurrentUser User
@inject IStreamSessionService SessionSvc

<PageTitle>آمار پخش | LiveStudio</PageTitle>

<header class="topbar"><div><div class="eyebrow">ANALYTICS / STREAMS</div><h1>آمار پخش‌ها</h1></div></header>

@if (_rows is null)
{
    <section class="panel mt-3"><p class="text-secondary m-0">در حال بارگذاری…</p></section>
}
else if (_rows.Count == 0)
{
    <section class="panel mt-3"><div class="empty-icon"><i class="bi bi-bar-chart"></i></div><p class="text-center text-secondary m-0">هنوز پخشی ثبت نشده است. پس از اولین Go live آمار اینجا نمایش داده می‌شود.</p></section>
}
else
{
    <div class="sy-stats mt-3" style="grid-template-columns:repeat(4,1fr)">
        <div><b>@Fa.Num(_rows.Count)</b><small>تعداد پخش</small></div>
        <div><b>@FormatDuration(TimeSpan.FromSeconds(_rows.Sum(r => r.Duration.TotalSeconds)))</b><small>مجموع مدت</small></div>
        <div><b>@Fa.Num(_rows.Max(r => r.PeakViewers))</b><small>بیشترین بیننده هم‌زمان</small></div>
        <div><b>@Fa.Num(_rows.Sum(r => r.Comments))</b><small>مجموع کامنت</small></div>
    </div>
    <section class="panel mt-3">
        <div class="table-responsive">
            <table class="table table-dark align-middle mb-0">
                <thead><tr><th>عنوان</th><th>شروع</th><th>مدت</th><th>اوج بیننده</th><th>بازدید</th><th>لایک</th><th>کامنت</th><th>مقصدها</th></tr></thead>
                <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.Title@if (r.IsLive) { <span class="badge bg-danger ms-1">زنده</span> }</td>
                        <td>@Fa.Date(r.StartedAt, true)</td>
                        <td>@FormatDuration(r.Duration)</td>
                        <td>@Fa.Num(r.PeakViewers)</td>
                        <td>@Fa.Num(r.Views)</td>
                        <td>@Fa.Num(r.Likes)</td>
                        <td>@Fa.Num(r.Comments)</td>
                        <td>@r.Destinations</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private IReadOnlyList<SessionRow>? _rows;

    protected override async Task OnInitializedAsync()
    {
        var uid = await User.UserIdAsync() ?? Guid.Empty;
        _rows = uid == Guid.Empty ? [] : await SessionSvc.ListAsync(uid, 100);
    }

    private static string FormatDuration(TimeSpan t) => $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";
}
