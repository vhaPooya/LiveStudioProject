    private SiteContent _site = new();
    private IReadOnlyList<FaqItem> _faq = [];
    private IReadOnlyList<SubscriptionPlan> _plans = [];
    private bool _yearly, _hasYearly, _hasMonthly;

    private IEnumerable<SubscriptionPlan> VisiblePlans =>
        _plans.Where(p => _hasYearly && _hasMonthly ? (p.DurationDays > 31) == _yearly : true);

    protected override async Task OnInitializedAsync()
    {
        _site = await Content.GetSiteContentAsync();
        _faq = await Content.GetFaqAsync(true);
        _plans = await Subscriptions.GetPlansAsync(true);
        _hasYearly = _plans.Any(p => p.DurationDays > 31);
        _hasMonthly = _plans.Any(p => p.DurationDays <= 31);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { try { await JS.InvokeVoidAsync("lsSite.initReveal"); } catch (JSException) { } }
        else { try { await JS.InvokeVoidAsync("lsSite.initReveal"); } catch (JSException) { } }
    }
