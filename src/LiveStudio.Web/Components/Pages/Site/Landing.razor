    private sealed record Step(string Icon, string Title, string Text);
    private sealed record UseCase(string Image, string Alt, string Title, string Text, string[] Tags);
    private sealed record TourItem(string Title, string Text);

    private static readonly UseCase[] UseCases =
    [
        new("case-youtube.webp", "استریمر پشت میز با هدفون و نور حلقه‌ای", "یوتیوبرها و استریمرها", "پخش زنده با لوگو، لایه‌ها و صحنه‌های آماده؛ بدون اینکه چند برنامه را کنار هم باز نگه دارید.", ["لوگو و قاب", "TAKE", "یوتیوب"]),
        new("case-edu.webp", "مدرس کنار تخته‌ی سفید در کلاس آنلاین", "آموزش و کلاس آنلاین", "تله‌پرومپتر، اشتراک صفحه و ضبط جلسه‌ها؛ هر درس هم زنده پخش می‌شود هم آرشیو می‌ماند.", ["تله‌پرومپتر", "اشتراک صفحه", "ضبط"]),
        new("case-event.webp", "سخنران روی صحنه‌ی همایش با نورهای رنگی", "رویدادها و همایش‌ها", "چند دوربین و صحنه‌ی از پیش‌چیده، زیرنویس و لوگوی اسپانسر؛ مدیریت برنامه‌ی زنده روی آنتن.", ["چند صحنه", "زیرنویس", "اسپانسر"]),
        new("case-podcast.webp", "دو مهمان پشت میکروفون در استودیوی پادکست", "پادکست و گفتگو", "میکسر صدای حرفه‌ای و اصلاح تصویر دوربین برای گفتگوهای طولانی و مصاحبه‌های زنده.", ["میکسر صدا", "اصلاح رنگ", "مصاحبه"])
    ];

    private static readonly TourItem[] Tour =
    [
        new("مانیتور Preview", "صحنه را آماده کنید، بدون اینکه بیننده تغییرات را ببیند."),
        new("دکمه TAKE", "با یک کلیک (یا TAKE خودکار) تغییرات را روی آنتن ببرید."),
        new("لایه‌ها و رسانه", "لوگو، تصویر، ویدئو و پس‌زمینه را مرتب و تنظیم کنید."),
        new("رنگ و میکسر صدا", "تصویر دوربین و سطح صدا را زنده اصلاح کنید.")
    ];
    private sealed record CompareRow(string Label, string Us, string Other);

    private static readonly Feature[] Features =
    [
        new("bi-browser-chrome", "t-violet", "استودیوی کامل داخل مرورگر", "دوربین، میکروفون، اشتراک صفحه و صحنه‌ها بدون نصب هیچ برنامه‌ای؛ همراه شما در هر رایانه."),
        new("bi-arrow-left-right", "t-blue", "Preview و Program با TAKE", "اول آماده کنید، بعد روی آنتن ببرید. TAKE دستی یا خودکار برای انتقال امن تغییرات."),
        new("bi-youtube", "t-red", "پخش مستقیم روی یوتیوب", "ارسال خروجی به رویداد یوتیوب شما از طریق LiveKit Egress؛ Stream Key هرگز به مرورگر نمی‌رسد."),
        new("bi-layers", "t-teal", "Compositor لایه‌ای", "لوگو، تصویر و ویدئو، پس‌زمینه ثابت یا متحرک، قاب‌های خالی و تنظیم شفافیت و نحوه نمایش."),
        new("bi-card-text", "t-amber", "تله‌پرومپتر هوشمند", "تله‌پرومپتر شناور و ذخیره‌شده، با کنترل کامل با کیبورد و بدون نمایش در خروجی."),
