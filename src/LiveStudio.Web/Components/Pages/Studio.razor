    [JSInvokable] public Task OnTeamEvent(string text) { SuccessMessage = text; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task OnHostState(string json)
    {
        try { using var doc = JsonDocument.Parse(json); NowPlaying = doc.RootElement.TryGetProperty("media", out var m) && m.ValueKind == JsonValueKind.Object ? m.GetProperty("title").GetString() : null; } catch { }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnLiveKitStatusChanged(string state, string message)
    {
        await InvokeAsync(() =>
        {
            switch (state)
            {
                case "connected":
                    IsConnected = true; StatusText = "به LiveKit متصل است";
                    break;
                case "connecting":
                    StatusText = "در حال اتصال";
                    break;
                case "reconnecting":
                    StatusText = "در حال بازیابی اتصال";
                    ErrorMessage = null;
                    break;
                case "disconnected":
                    IsConnected = false;
                    CameraEnabled = MicrophoneEnabled = ScreenShareEnabled = ProgramOutputEnabled = false;
                    StatusText = "اتصال قطع شد";
                    if (!string.IsNullOrWhiteSpace(message)) ErrorMessage = message;
                    break;
                case "device-error":
                case "error":
                    ErrorMessage = message;
                    break;
            }
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnLiveKitDevicesChanged()
    {
        if (!IsConnected) return;
        try { await InvokeAsync(RefreshDevicesAsync); }
        catch (JSDisconnectedException) { }
    }

    private async Task RefreshDevicesAsync()
    {
        var devices = await JS.InvokeAsync<DeviceListDto>("liveStudio.getDevices");
        Cameras = devices.Cameras;
        Microphones = devices.Microphones;
        SelectedCamera ??= Cameras.FirstOrDefault()?.DeviceId;
        SelectedMicrophone ??= Microphones.FirstOrDefault()?.DeviceId;
    }

    private async Task RunDeviceActionAsync(Func<Task> action)
    {
        IsBusy = true; ErrorMessage = null;
        try { await action(); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsBusy = false; }
    }

    private async Task DisconnectAsync()
    {
        IsBusy = true;
        try
        {
            if (YouTubeEgressActive) await StopYouTubeEgressCoreAsync();
            await JS.InvokeVoidAsync("lsTeam.hostStop");
            await JS.InvokeVoidAsync("liveStudio.disconnect");
            IsConnected = CameraEnabled = MicrophoneEnabled = ScreenShareEnabled = ProgramOutputEnabled = false;
            StatusText = "اتصال قطع شد";
            Cameras.Clear(); Microphones.Clear();
            SelectedCamera = SelectedMicrophone = null;
            _lobbyStarted = false;
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsBusy = false; }
    }

    private static async Task<string> ExtractErrorAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        try
        {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("detail", out var detail)) return detail.GetString() ?? body;
            if (doc.RootElement.TryGetProperty("error", out var error)) return error.GetString() ?? body;
        }
        catch { }
        return string.IsNullOrWhiteSpace(body) ? $"خطای سرور: {(int)response.StatusCode}" : body;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("liveStudio.setStatusHandler", (object?)null); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        try { await JS.InvokeVoidAsync("liveStudio.disconnect"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        StopPolling();
        try { await JS.InvokeVoidAsync("lsLobby.stop"); await JS.InvokeVoidAsync("lsTeam.hostStop"); } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        _statusReference?.Dispose();
        _statusReference = null;
    }

    private sealed record LiveKitSessionResponse(string Url, string Token, string RoomName, string ParticipantIdentity, DateTimeOffset ExpiresAt);
    private sealed record EgressStatusDto(bool IsRunning, string? EgressId, string Status, string? Error, int DestinationCount = 0);
    private sealed record MediaDeviceDto(string DeviceId, string Label);
    private sealed record DeviceListDto(List<MediaDeviceDto> Cameras, List<MediaDeviceDto> Microphones);
