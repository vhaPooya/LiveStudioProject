@if (!string.IsNullOrWhiteSpace(Error)) { <div class="notice notice-error"><i class="bi bi-exclamation-triangle-fill ms-2"></i>@Error</div> }
@if (!string.IsNullOrWhiteSpace(Success)) { <div class="notice notice-success"><i class="bi bi-check-circle-fill ms-2"></i>@Success</div> }
@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Success { get; set; }
}
