@inject NavigationManager Navigation
@code {
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = relative.StartsWith("admin", StringComparison.OrdinalIgnoreCase) ? "admin/login" : "login";
        Navigation.NavigateTo($"{target}?returnUrl={Uri.EscapeDataString("/" + relative)}", forceLoad: true);
    }
}
