<div class="search-box">
    <i class="bi bi-search"></i>
    <input class="form-control" type="search" placeholder="@Placeholder" value="@Value" @oninput="OnInput" />
</div>
@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Placeholder { get; set; } = "جستجو...";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int DebounceMs { get; set; } = 350;
    private CancellationTokenSource? _cts;

    private async Task OnInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        try
        {
            await Task.Delay(DebounceMs, _cts.Token);
            Value = text;
            await ValueChanged.InvokeAsync(text);
        }
        catch (TaskCanceledException) { }
    }
}
