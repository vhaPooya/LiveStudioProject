@inject IJSRuntime JS

<div>
    <div class="ls-inspector-title"><div><small>SOUNDBOARD</small><h4>صداهای جلوه‌ای</h4></div><i class="bi bi-music-note-beamed"></i></div>
    <small class="text-secondary d-block mb-2">@(Remote ? "صدا روی پخش زنده پخش می‌شود (از طریق استودیوی میزبان)." : "صدا هم به خروجی پخش اضافه می‌شود و هم روی بلندگوی شما شنیده می‌شود.")</small>
    <div class="sy-sfx">
        @foreach (var s in Sounds)
        {
            <button type="button" @onclick="() => PlayAsync(s.Key)"><i class="bi @s.Icon"></i>@s.Label</button>
        }
    </div>
    <div class="ls-control-slider mt-3"><label><span>بلندی</span><strong>@Volume%</strong></label><input class="form-range" type="range" min="10" max="150" step="5" value="@Volume" @oninput="e => Volume = int.TryParse(e.Value?.ToString(), out var v) ? v : 100" /></div>
    @if (!Remote)
    {
        <div class="ls-control-slider"><label><span>پخش روی بلندگوی خودم</span><strong>@Monitor%</strong></label><input class="form-range" type="range" min="0" max="100" step="5" value="@Monitor" @oninput="MonitorChanged" /></div>
    }
    @if (!string.IsNullOrEmpty(_error)) { <small class="text-warning d-block mt-2">@_error</small> }
</div>

@code {
    private sealed record Sound(string Key, string Label, string Icon);
    private static readonly Sound[] Sounds =
    [
        new("applause", "تشویق", "bi-hand-thumbs-up"), new("cheer", "هورا", "bi-emoji-laughing"), new("drumroll", "طبل", "bi-record-circle"), new("tada", "تادا!", "bi-stars"),
        new("airhorn", "بوق", "bi-megaphone"), new("ding", "زنگ", "bi-bell"), new("buzzer", "ایراد", "bi-x-octagon"), new("whoosh", "ویژ", "bi-wind"),
        new("pop", "پاپ", "bi-balloon"), new("sad", "غمگین", "bi-emoji-frown")
    ];

    /// <summary>true = the sound is played by the host studio (team console).</summary>
    [Parameter] public bool Remote { get; set; }
    private int Volume = 100, Monitor = 35;
    private string? _error;

    private async Task PlayAsync(string key)
    {
        _error = null;
        try
        {
            if (Remote) await JS.InvokeVoidAsync("lsTeam.send", "sfx.play", new { key, volume = Volume / 100.0 });
            else await JS.InvokeVoidAsync("lsSfx.play", key, Volume / 100.0);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task MonitorChanged(ChangeEventArgs e)
    {
        Monitor = int.TryParse(e.Value?.ToString(), out var v) ? v : 35;
        try { await JS.InvokeVoidAsync("lsSfx.setMonitor", Monitor / 100.0); } catch { }
    }
}
