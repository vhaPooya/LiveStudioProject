    private Task SliderChangedAsync(string key, ChangeEventArgs e, string scope) => Safe(async () =>
    {
        if (scope == "layer" && SelectedLayerId is not null) { await JS.InvokeAsync<ComposerState>("studioCompositor.updateLayer", Mode, SelectedLayerId, key, e.Value); await RefreshStateAsync(); }
        else if (scope == "camera") await UpdateCameraAsync(key, e);
    });
    private static bool IsMediaLayer(LayerDto l) => l.Type is "image" or "video";
    private string LayerName(LayerDto l)
    {
        if (IsMediaLayer(l))
        {
            var asset = string.IsNullOrWhiteSpace(l.AssetId) ? null : Assets.FirstOrDefault(a => a.Id == l.AssetId);
            if (asset is not null) return (l.Type == "video" ? "ویدئو · " : "تصویر · ") + asset.Name;
            return l.Type == "video" ? "قاب ویدئو (خالی)" : "قاب لوگو (خالی)";
        }
        return l.Type switch { "text" => string.IsNullOrWhiteSpace(l.Text) ? "متن جدید" : l.Text!, "lowerThird" => "Lower Third", "breaking" => "Breaking News", "ticker" => "تیکر خبری", "countdown" => "تایمر شمارش معکوس", "comment" => "کامنت روی تصویر", _ => "المان" };
    }
    private static string SafeColor(string? value) => !string.IsNullOrWhiteSpace(value) && value.StartsWith('#') && value.Length == 7 ? value : "#10233b";
