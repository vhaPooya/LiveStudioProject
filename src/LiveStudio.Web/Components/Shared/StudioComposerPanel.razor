    // ---------- Upload ----------
    private async Task<AssetDto?> UploadCoreAsync(InputFileChangeEventArgs e)
    {
        var file = e.File; if (file is null) return null;
        var type = file.ContentType;
        if (string.IsNullOrWhiteSpace(type))
        {
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            type = ext switch { ".mp4" or ".m4v" => "video/mp4", ".webm" => "video/webm", ".mov" => "video/quicktime", ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".gif" => "image/gif", ".webp" => "image/webp", ".svg" => "image/svg+xml", _ => "" };
        }
        var isVideo = type.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
        var isImage = type.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
        if (!isVideo && !isImage) { Notice("فقط فایل تصویر یا ویدئو پشتیبانی می‌شود.", true); return null; }
        UploadBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 300L * 1024 * 1024);
            using var reference = new DotNetStreamReference(stream);
            var dto = await JS.InvokeAsync<AssetDto>("mediaBox.add", file.Name, type, isVideo ? "stinger" : "overlay", file.Size, reference);
            await JS.InvokeVoidAsync("studioCompositor.refreshAssets");
            await LoadAssetsAsync();
            return Assets.FirstOrDefault(a => a.Id == dto.Id) ?? dto;
        }
        catch (Exception ex) { Notice("افزودن فایل ناموفق بود: " + ex.Message, true); return null; }
        finally { UploadBusy = false; }
    }
    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        var asset = await UploadCoreAsync(e);
        if (asset is not null) { SelectedAssetId = asset.Id; Notice("فایل به Media Box اضافه شد؛ برای استفاده، «افزودن رسانه انتخاب‌شده به صحنه» را بزنید.", false); }
    }
    private async Task UploadAndApplyAsync(InputFileChangeEventArgs e)
    {
        var asset = await UploadCoreAsync(e);
        if (asset is not null) await SetLayerAssetAsync(asset.Id);
    }

